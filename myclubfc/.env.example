# Supabase - https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domínio raiz da plataforma (sem o protocolo). Ex: myclubfc.com
# Subdomínios viram tenants: kfc.myclubfc.com -> tenant slug "kfc"
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Slug do tenant default em dev (quando acessar localhost sem subdomínio)
# Pode ser sobrescrito via ?tenant=outro na URL
NEXT_PUBLIC_DEFAULT_TENANT=kfc
